      "isBinary": false, "overrideBlink": "blend", "overrideMouth": "blend",
      "vrm0Preset": "angry", "vrm0Name": "Angry"
    },
    "sad": {
      "mix": {"browInnerUp": 0.9, "browDownLeft": 0.25, "browDownRight": 0.25, "eyeBlinkLeft": 0.15, "eyeBlinkRight": 0.15, "mouthFrownLeft": 0.6, "mouthFrownRight": 0.6, "mouthShrugLower": 0.35},
      "isBinary": false, "overrideBlink": "blend", "overrideMouth": "blend",
