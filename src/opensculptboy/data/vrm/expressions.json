    "NN": {"mix": {"jawOpen": 0.14, "mouthStretchLeft": 0.1, "mouthStretchRight": 0.1, "mouthLowerDownLeft": 0.1, "mouthLowerDownRight": 0.1}, "versions": ["0.x"]},
    "RR": {"mix": {"jawOpen": 0.12, "mouthFunnel": 0.3, "mouthPucker": 0.35}, "versions": ["0.x"]}
