{
 "format": "portrait-of-a-boy/correctives@1",
 "conventions": {
  "units": "metres and degrees",
  "axes": "X to the left of the figure, Y up, Z forward; every bone rests with the world axes",
  "shapes": "morph targets on the body mesh, in the rest pose, added before skinning",
  "hinge": "angle between the vectors head(bones[1]) - head(bones[0]) and head(bones[2]) - head(bones[1]), from world positions; the weights interpolate linearly between neighbouring keys and stay at the first or last key outside them; a key with shape null has no shape",
  "cone": "d = normalize(inverse(rotation(frame)) * (head(end) - head(bone))), from world transforms; for each triangle solve d = a*t0 + b*t1 + c*t2 and divide by a + b + c; the triangle with the largest smallest coordinate wins; negative coordinates become 0 and the rest are divided by their sum; the weight of a target is its coordinate",
  "girdle": {
   "note": "The shoulder key poses move the clavicle and shoulder01 with the arm by this rule. Animations that move the girdle in the same way match the shapes best.",
   "angles": "d is the shoulder direction of the cone driver; e = acos(-d.y) is the elevation from straight down and p = atan2(d.z, s * d.x) is the plane (0 out to the side, 90 forward), with s = 1 for .L and -1 for .R",
   "raise_deg": "up = 0.26 * x * x / (x + 20) - 2.929, with x = max(0, e - 20)",
   "forward_deg": "prot = 10 * max(sin(e) sin(p), 0) + 10 * max(-sin(e) cos(p), 0) - 6 * max(-sin(e) sin(p), 0) - 0.044",
   "bones": "left side: clavicle.L turns by 0.6 * up about Z and then by prot about -Y, and shoulder01.L turns by 0.4 * up about Z, each relative to its parent; the right side turns the other way about Z and about Y"
  }
